# Copier en .env pour le développement local (jamais commité).
# Sans SQL_CONNECTION_STRING, l'API tourne en mémoire avec des données de démo.
# SQL_CONNECTION_STRING=Server=tcp:xxx.database.windows.net,1433;Database=jobhunt;User Id=...;Password=...;Encrypt=true
ANTHROPIC_API_KEY=
# Base de connaissance : dossier local (clone de jobhunt-knowledge) ou dépôt GitHub
KNOWLEDGE_DIR=../jobhunt-knowledge
# KNOWLEDGE_REPO=Antoine2F/jobhunt-knowledge
# KNOWLEDGE_TOKEN=
# Pour tester la veille en local
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# APP_URL=http://localhost:7071
# INGEST_KEY=dev
