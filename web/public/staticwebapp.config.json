{
  "platform": { "apiRuntime": "node:20" },
  "routes": [
    { "route": "/manifest.webmanifest", "allowedRoles": ["anonymous"] },
    { "route": "/icon*", "allowedRoles": ["anonymous"] },
    { "route": "/sw.js", "allowedRoles": ["anonymous"], "headers": { "cache-control": "no-cache" } },
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/api/ingest*", "allowedRoles": ["anonymous"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/github?post_login_redirect_uri=.referrer", "statusCode": 302 }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/*.{png,svg,webmanifest,js,json}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin",
    "X-Frame-Options": "DENY"
  }
}
